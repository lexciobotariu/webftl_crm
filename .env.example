# Copy to .env and fill in. Never commit the real .env.

# --- Core ---------------------------------------------------------------
# DEBUG=False is the default. Leave it False anywhere but your own machine.
DEBUG=True
# Required whenever DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Key for encrypting stored GitHub tokens. Required whenever DEBUG=False.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Hosts --------------------------------------------------------------
# Comma-separated hostnames this app answers to. Required when DEBUG=False;
# when DEBUG=True it defaults to localhost,127.0.0.1,[::1].
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (with scheme) allowed to POST. Needed behind HTTPS.
# CSRF_TRUSTED_ORIGINS=https://crm.example.com

# --- Time zone ----------------------------------------------------------
# One time zone for the whole app: it decides what "today" is, which day a
# logged time lands on, and the hours shown in activity and comments.
# Any IANA name, e.g. Europe/Bucharest or America/New_York. Defaults to
# Europe/Bucharest. Dates and times are stored in UTC either way.
# TIME_ZONE=Europe/Bucharest

# --- Database -----------------------------------------------------------
# Used by docker-compose to provision the container.
POSTGRES_DB=webftl_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Used by Django. Keep the port in sync with docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/webftl_crm

# --- TLS / proxy --------------------------------------------------------
# When DEBUG=False, HTTP is redirected to HTTPS by default. Set False if
# something in front of the app already handles that.
# SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds; 0 disables the header.
# SECURE_HSTS_SECONDS=31536000
# Set True only behind a proxy you trust to set X-Forwarded-Proto — otherwise
# SECURE_SSL_REDIRECT will loop, because Django only ever sees plain HTTP.
# USE_X_FORWARDED_PROTO=False

# --- Email --------------------------------------------------------------
# A Resend API key sends all mail (invoices, reminders, password resets)
# through Resend; leave EMAIL_BACKEND unset then. The from address must be on a
# domain verified in Resend. Quotes around values are optional.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=WebFTL <facturi@example.com>
#
# Without a key, EMAIL_BACKEND picks another backend. Unset with DEBUG=True
# prints mail to the console. Unset with DEBUG=False warns and discards mail.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=crm@example.com

# --- Integrations -------------------------------------------------------
# Shared secret for the GitHub webhook. Webhook requests are rejected unless
# this is set and the signature matches.
GITHUB_WEBHOOK_SECRET=

# --- Logging ------------------------------------------------------------
# Root log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
